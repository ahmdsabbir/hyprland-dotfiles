#!/usr/bin/env bash
# Power: lock, log out, restart, shut down.
#
# Usage: hypr-power menu                       the power modal (SUPER+Escape,
#                                              Waybar power icon)
#        hypr-power lock|logout|reboot|shutdown [--yes]
#
#   --yes   skip the confirmation
#
# The modal (rofi, rofi/power.rasi) shows four big buttons over the blurred
# backdrop. Arrows + Enter, a click, or a letter: L lock, E log out (exit),
# R restart, S shut down. Log out / restart / shut down then ask in the same
# style: Enter or Y confirms, Esc or N cancels (Cancel is preselected).

set -uo pipefail

SELF="$0"
THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/power.rasi"
ICON_FONT="FantasqueSansM Nerd Font"

action="${1:-}"
assume_yes=0
[[ "${2:-}" == "--yes" ]] && assume_yes=1

# One button: big icon, then the label with its shortcut letter faded.
button() {  # icon, label, key
    printf "<span font='%s 30'>%s</span>\n%s  <span size='small' fgalpha='55%%'>%s</span>" \
        "$ICON_FONT" "$1" "$2" "$3"
}

# Show buttons ($@) in the modal; print the picked index (or custom key code).
modal() {  # message, extra rofi args..., then "--", buttons...
    local mesg="$1"; shift
    local -a args=()
    while [[ "$1" != "--" ]]; do args+=("$1"); shift; done
    shift
    local IFS='|'
    printf '%s' "$*" | rofi -dmenu -sep '|' -eh 3 -markup-rows -format i -no-custom \
        -theme "$THEME" -mesg "$mesg" "${args[@]}"
}

uptime_short() {
    local s
    s="$(uptime -p 2>/dev/null | sed -e 's/^up //' -e 's/ hours\?/h/' -e 's/ minutes\?/m/' -e 's/ days\?/d/' -e 's/ weeks\?/w/' -e 's/,//g')"
    printf '%s' "${s:-?}"
}

# Ask before logout / restart / shutdown. Returns 0 to go ahead.
confirm() {  # question, icon, label
    (( assume_yes )) && return 0
    local pick
    pick="$(modal "$1" -selected-row 0 \
                -kb-custom-1 y -kb-custom-2 n \
                -theme-str 'mainbox { width: 420px; } listview { columns: 2; }' \
                -- "$(button "󰜺" "Cancel" "N")" "$(button "$2" "$3" "Y")")"
    case $? in
        0)  [[ "$pick" == 1 ]] ;;   # Enter / click: only the action button confirms
        10) return 0 ;;             # Y
        *)  return 1 ;;             # N, Esc
    esac
}

case "$action" in
    menu)
        pick="$(modal "$USER · up $(uptime_short)" \
                    -kb-custom-1 l -kb-custom-2 e -kb-custom-3 r -kb-custom-4 s \
                    -- "$(button "󰌾" "Lock" "L")" "$(button "󰍃" "Log out" "E")" \
                       "$(button "󰜉" "Restart" "R")" "$(button "󰐥" "Shut down" "S")")"
        case $? in
            0)  case "$pick" in 0) exec "$SELF" lock ;; 1) exec "$SELF" logout ;;
                                2) exec "$SELF" reboot ;; 3) exec "$SELF" shutdown ;; esac ;;
            10) exec "$SELF" lock ;;
            11) exec "$SELF" logout ;;
            12) exec "$SELF" reboot ;;
            13) exec "$SELF" shutdown ;;
        esac
        exit 0
        ;;
    lock)
        # No confirmation: locking is harmless. One hyprlock at a time.
        pidof hyprlock >/dev/null || exec hyprlock
        ;;
    logout)
        confirm "End this Hyprland session?" "󰍃" "Log out" || exit 0
        # Prefer hyprshutdown (closes apps gracefully) if installed.
        if command -v hyprshutdown >/dev/null; then
            hyprshutdown
        else
            hyprctl dispatch 'hl.dsp.exit()'
        fi
        ;;
    reboot)
        confirm "Restart the computer?" "󰜉" "Restart" || exit 0
        systemctl reboot
        ;;
    shutdown)
        confirm "Shut down the computer?" "󰐥" "Shut down" || exit 0
        systemctl poweroff
        ;;
    -h|--help|"")
        sed -n '2,13p' "$SELF" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "Unknown action: $action (menu|lock|logout|reboot|shutdown)" >&2
        exit 2
        ;;
esac
