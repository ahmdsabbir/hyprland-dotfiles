#!/usr/bin/env bash
# Lock, log out, reboot or shut down (the last three after a confirmation dialog).
#
# Usage: hypr-power lock|logout|reboot|shutdown [--yes]
#        hypr-power menu      pick one in rofi (SUPER+Escape)
#
#   --yes   Skip the confirmation dialog.
#
# Used by the Waybar power buttons. Confirmation uses zenity when available;
# without it (and without --yes) nothing happens, to avoid accidents.

set -uo pipefail

action="${1:-}"
assume_yes=0
[[ "${2:-}" == "--yes" ]] && assume_yes=1

if [[ "$action" == lock ]]; then
    # No confirmation: locking is harmless. One hyprlock at a time.
    pidof hyprlock >/dev/null || exec hyprlock
    exit 0
fi

if [[ "$action" == menu ]]; then
    # Rows with icons; -format i returns the picked row's index.
    choice="$(printf '%s\0icon\x1f%s\n' \
            "Lock"      system-lock-screen \
            "Log out"   system-log-out \
            "Restart"   system-reboot \
            "Shut down" system-shutdown \
        | rofi -dmenu -i -format i -p power -theme-str 'entry { placeholder: "Power"; } listview { lines: 4; }')" || exit 0
    case "$choice" in
        0) exec "$0" lock ;;
        1) exec "$0" logout ;;
        2) exec "$0" reboot ;;
        3) exec "$0" shutdown ;;
        *) exit 0 ;;
    esac
fi

case "$action" in
    logout)   title="Log out?";   text="End this Hyprland session?";  ok="Log out" ;;
    reboot)   title="Restart?";   text="Restart the computer?";        ok="Restart" ;;
    shutdown) title="Shut down?"; text="Shut down the computer?";      ok="Shut down" ;;
    -h|--help|"") sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown action: $action (lock|logout|reboot|shutdown|menu)" >&2; exit 2 ;;
esac

if (( ! assume_yes )); then
    command -v zenity >/dev/null || { echo "zenity not installed; use --yes to skip confirmation." >&2; exit 1; }
    zenity --question --title="$title" --text="$text" \
        --ok-label="$ok" --cancel-label="Cancel" --width=280 2>/dev/null || exit 0
fi

case "$action" in
    logout)
        # Prefer hyprshutdown (closes apps gracefully) if installed, like the stock SUPER+M bind.
        if command -v hyprshutdown >/dev/null; then
            hyprshutdown
        else
            hyprctl dispatch 'hl.dsp.exit()'
        fi
        ;;
    reboot)   systemctl reboot ;;
    shutdown) systemctl poweroff ;;
esac
