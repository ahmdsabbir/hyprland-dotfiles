#!/usr/bin/env bash
# Switch the whole desktop between themes (light / dark / ...).
#
# Usage: hypr-theme                 show the current theme
#        hypr-theme light|dark      switch to a theme
#        hypr-theme toggle          light <-> dark            (SUPER+SHIFT+T)
#        hypr-theme apply           re-generate the current theme (after
#                                   editing a palette or template)
#        hypr-theme list            available themes
#        hypr-theme clean           remove generated files (used by uninstall)
#
#   --no-reload   generate files only; don't reload apps (used by install)
#
# Each theme's palette is themes/<name>.colors. Hyprland reads it directly; for
# the other apps this renders themes/templates/* into their config folders
# (outside the repo), which their configs include. Then it sets the GTK color
# scheme and reloads Hyprland, Waybar, kitty and mako (hypr-reload). rofi and
# hyprlock read the new colors the next time they open; the zsh prompt follows
# kitty.

set -uo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
THEMES="${HYPR_THEMES_DIR:-$CFG/hypr/themes}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yonko"
STATE="$STATE_DIR/theme"
DEFAULT=light
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# template : generated file
TARGETS=(
    "kitty.conf:$CFG/kitty/theme.conf"
    "waybar.css:$CFG/waybar/theme.css"
    "rofi.rasi:$CFG/rofi/theme.rasi"
    "hyprlock.conf:$CFG/hypr/hyprlock-theme.conf"
    "mako:$CFG/mako/theme"
)
GTK_OUT="$CFG/gtk-4.0/gtk.css"   # holds every theme, picked by color scheme

die() { echo "hypr-theme: $*" >&2; exit 1; }

current() {
    local name=""
    [[ -f "$STATE" ]] && read -r name < "$STATE"
    [[ -n "$name" && -f "$THEMES/$name.colors" ]] && echo "$name" || echo "$DEFAULT"
}

list() {
    local f
    for f in "$THEMES"/*.colors; do [[ -e "$f" ]] && basename "$f" .colors; done
}

# Load themes/<name>.colors into the global associative array P.
declare -A P
load_palette() {
    local file="$THEMES/$1.colors" line
    [[ -f "$file" ]] || die "no such theme: $1 (try: $(list | tr '\n' ' '))"
    P=( [name]="$1" )
    while IFS= read -r line; do
        if [[ "$line" =~ ^[[:space:]]*([a-z0-9_]+)[[:space:]]*=[[:space:]]*([^[:space:]#]+) ]]; then
            P[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"
        fi
    done < "$file"
}

# Print a template with every {{key}} replaced from P; fail on unknown keys.
render() {
    local content key
    content="$(<"$1")" || die "missing template: $1"
    for key in "${!P[@]}"; do
        content="${content//"{{$key}}"/${P[$key]}}"
    done
    if [[ "$content" =~ \{\{([a-z0-9_]+)\}\} ]]; then
        die "$(basename "$1"): palette '${P[name]}' has no key '${BASH_REMATCH[1]}'"
    fi
    printf '%s\n' "$content"
}

# Write atomically. Skip apps that aren't set up (no config folder); refuse a
# folder that is itself a symlink, so generated files never land in the repo.
write_file() {
    local dest="$1" content="$2" dir
    dir="$(dirname "$dest")"
    [[ -d "$dir" ]] || return 0
    [[ -L "$dir" ]] && { echo "hypr-theme: skipping $dest ($dir is a symlink)" >&2; return 0; }
    printf '%s' "$content" > "$dest.tmp.$$" && mv -f "$dest.tmp.$$" "$dest"
}

generate() {
    local name="$1" t tpl dest content f scheme media gtk

    # GTK: one file with a block per theme, chosen by the system color scheme,
    # so open GTK apps switch instantly along with it.
    gtk=$'/* Generated by hypr-theme from themes/*.colors — do not edit.\n'
    gtk+=$' * Edit a palette or themes/templates/gtk.css, then: hypr-theme apply */\n'
    for f in "$THEMES"/*.colors; do
        load_palette "$(basename "$f" .colors)"
        scheme="${P[color_scheme]:-}"
        case "$scheme" in
            prefer-light) media=light ;;
            prefer-dark)  media=dark ;;
            *) continue ;;
        esac
        content="$(render "$THEMES/templates/gtk.css")" || exit 1
        gtk+=$'\n'"@media (prefers-color-scheme: $media) {"$'\n    :root {\n'
        gtk+="$content"
        gtk+=$'\n    }\n}\n'
    done

    # Render everything first; write only if all templates succeeded, so a
    # mistake never leaves apps half switched.
    local -a dests=() outputs=()
    load_palette "$name"
    for t in "${TARGETS[@]}"; do
        tpl="${t%%:*}"; dest="${t#*:}"
        content="$(render "$THEMES/templates/$tpl")" || exit 1
        if [[ "$tpl" == kitty.conf && -f "$THEMES/$name.kitty-extra" ]]; then
            content+=$'\n'"$(<"$THEMES/$name.kitty-extra")"
        fi
        dests+=("$dest"); outputs+=("$content"$'\n')
    done

    write_file "$GTK_OUT" "$gtk"
    local i
    for i in "${!dests[@]}"; do
        write_file "${dests[$i]}" "${outputs[$i]}"
    done
}

apply() {  # $1 = theme, $2 = reload (1/0)
    local name="$1" reload="$2"
    generate "$name"
    mkdir -p "$STATE_DIR" && echo "$name" > "$STATE"

    if [[ -n "${P[color_scheme]:-}" ]] && command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface color-scheme "${P[color_scheme]}" 2>/dev/null || true
    fi

    if (( reload )); then
        "$HERE/hypr-reload" --quiet || true
        command -v notify-send >/dev/null && notify-send -u low -a hypr-theme "Theme: $name" 2>/dev/null || true
    fi
}

clean() {
    local t dest
    for t in "${TARGETS[@]}"; do
        dest="${t#*:}"
        [[ -f "$dest" && ! -L "$dest" ]] && rm -f "$dest" && echo "removed $dest"
    done
    [[ -f "$GTK_OUT" && ! -L "$GTK_OUT" ]] && rm -f "$GTK_OUT" && echo "removed $GTK_OUT"
    rm -f "$STATE"
}

reload=1
args=()
for a in "$@"; do
    [[ "$a" == --no-reload ]] && reload=0 || args+=("$a")
done
set -- "${args[@]+"${args[@]}"}"

case "${1:-}" in
    "")            current ;;
    list)          list ;;
    apply)         apply "$(current)" "$reload" ;;
    toggle)        [[ "$(current)" == dark ]] && apply light "$reload" || apply dark "$reload" ;;
    clean)         clean ;;
    -h|--help)     sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    -*)            die "unknown option: $1 (see --help)" ;;
    *)             apply "$1" "$reload" ;;
esac
