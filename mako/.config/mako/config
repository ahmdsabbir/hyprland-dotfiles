# mako: notifications. Colors, format and the urgency/do-not-disturb rules
# come from ~/.config/mako/theme (generated by hypr-theme, included at the
# end because mako's [criteria] sections must come last). Docs: man 5 mako
# Reload: makoctl reload (hypr-reload does it).
#
# Mouse: left = run the notification's action, right = dismiss,
#        middle = dismiss all.
# Keys:  SUPER+N dismiss · SUPER+SHIFT+N dismiss all ·
#        SUPER+CTRL+N bring back the last one · SUPER+ALT+N do-not-disturb

# --- Look --------------------------------------------------------------------

font=Liberation Mono 11
border-size=2
border-radius=6
padding=14,16

width=380
height=180
margin=6
anchor=top-right
layer=top

icons=1
icon-location=left
max-icon-size=40

# --- Behaviour ---------------------------------------------------------------

default-timeout=5000
ignore-timeout=0
max-visible=4
sort=-time
group-by=app-name,summary
history=1
max-history=20

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all

# --- Theme (colors, format, urgency + do-not-disturb rules) -----------------
# Must stay last.
include=~/.config/mako/theme
