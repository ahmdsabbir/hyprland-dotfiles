/* Power modal (hypr-power menu): big buttons in a row over the blurred
 * backdrop, like the launcher. Also used for the "Shut down?" confirmation.
 * Colors come from theme.rasi (generated by hypr-theme). */

@import "~/.config/rofi/theme.rasi"

* {
    font:             "Liberation Mono 12";
    background-color: transparent;
    text-color:       @text;
}

/* --- Backdrop + centered panel (same as layout.rasi) ------------------------ */

window {
    fullscreen:       true;
    padding:          0;
    border:           0;
    background-color: @backdrop;
    children:         [ backdrop ];
}

backdrop {
    orientation: vertical;
    children:    [ spacer-top, row, spacer-bottom ];
}

spacer-top, spacer-bottom, spacer-left, spacer-right {
    expand: true;
}

row {
    orientation: horizontal;
    expand:      false;
    children:    [ spacer-left, mainbox, spacer-right ];
}

mainbox {
    expand:           false;
    width:            700px;
    padding:          30px;
    spacing:          22px;
    border:           2px solid;
    border-color:     @frame;
    border-radius:    14px;
    background-color: @surface;
    children:         [ message, listview ];
}

/* --- Header: "sabbir · up 3h 12m" / "Shut down the computer?" -------------- */

message {
    padding: 0;
}

textbox {
    horizontal-align: 0.5;
    text-color:       @subtext;
}

/* --- Buttons --------------------------------------------------------------- */

listview {
    columns:       4;
    lines:         1;
    flow:          horizontal;
    spacing:       14px;
    fixed-columns: true;
    fixed-height:  true;
    scrollbar:     false;
    cycle:         true;
}

element {
    orientation:      vertical;
    padding:          26px 0 22px 0;
    border-radius:    12px;
    background-color: @surface2;
    text-color:       @subtext;
    children:         [ element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: @surface2;
    text-color:       @subtext;
}

element selected.normal {
    background-color: @accent;
    text-color:       @accent-fg;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}
