/* rofi layout (theme-independent). Colors come from theme.rasi, generated by
 * hypr-theme from the active palette (hypr/.config/hypr/themes/<name>.colors).
 * Layout matches the "hyprink monotone" launcher. */

@import "~/.config/rofi/theme.rasi"

* {
    font:             "Liberation Mono 12";
    background-color: transparent;
    text-color:       @text;
}

/* --- Backdrop + panel --------------------------------------------------------
 * The window covers the whole screen with a faint tint; Hyprland blurs what's
 * behind it (layer rule "blur-behind-launcher"). The panel (mainbox, 764px)
 * is centered by expanding spacers on all four sides.
 */

window {
    fullscreen:       true;
    padding:          0;
    border:           0;
    background-color: @backdrop;   /* faint tint of the theme background */
    children:         [ backdrop ];
}

backdrop {
    orientation: vertical;
    children:    [ spacer-top, row, spacer-bottom ];
}

spacer-top, spacer-bottom, spacer-left, spacer-right {
    expand: true;
}

row {
    orientation: horizontal;
    expand:      false;
    children:    [ spacer-left, mainbox, spacer-right ];
}

mainbox {
    expand:           false;
    width:            764px;
    padding:          28px;
    spacing:          16px;
    border:           2px solid;
    border-color:     @frame;
    border-radius:    8px;
    background-color: @surface;
    children:         [ inputbar, message, listview ];
}

/* --- Search box: "Type to filter" ... "/" ---------------------------------- */

inputbar {
    padding:  6px 4px;
    spacing:  12px;
    children: [ entry, textbox-slash ];
}

entry {
    placeholder:       "Type to filter";
    placeholder-color: @muted;
    text-color:        @text;
    cursor:            text;
}

textbox-slash {
    expand:     false;
    content:    "/";
    text-color: @muted;
}

/* Messages from scripts (e.g. the calculator's hint/result line). */
message {
    padding: 0 4px;
}

textbox {
    text-color: @subtext;
}

/* --- Results -------------------------------------------------------------- */

listview {
    lines:        6;
    columns:      1;
    spacing:      2px;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
}

/* 80px rows: 8 + (8 + 48 + 8) + 8 */
element {
    padding:       8px;
    spacing:       30px;
    border-radius: 8px;
    children:      [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @subtext;
}

element selected.normal {
    background-color: @accent;
    text-color:       @accent-fg;
}

element normal.urgent,
element alternate.urgent  { text-color: @text; }
element selected.urgent   { background-color: @accent; text-color: @accent-fg; }
element normal.active,
element alternate.active  { text-color: @text; }
element selected.active   { background-color: @accent; text-color: @accent-fg; }

/* Icon on its own tile; on the selected row the tile keeps the panel color. */
element-icon {
    size:             48px;
    padding:          8px;
    border-radius:    8px;
    background-color: transparent;
}

element-icon selected {
    background-color: @surface;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold;
}

/* Error dialogs (e.g. rofi config errors) */
error-message {
    padding:          20px;
    border:           2px solid;
    border-color:     @frame;
    border-radius:    8px;
    background-color: @surface;
}
