# Generated by hypr-theme from themes/{{name}}.colors — do not edit.
# Edit the palette or themes/templates/mako, then: hypr-theme apply
# Included at the end of ~/.config/mako/config. mako's [criteria] sections must
# come last, so the urgency/do-not-disturb rules live here with the colors.

background-color=#{{surface}}
text-color=#{{text}}
border-color=#{{frame}}
progress-color=over #{{overlay}}

# Small faint app name, bold title, then the body.
format=<span size="small" foreground="#{{subtext}}">%a</span>\n<b>%s</b>\n%b

[grouped]
format=<span size="small" foreground="#{{subtext}}">%a · %g</span>\n<b>%s</b>\n%b

[urgency=low]
text-color=#{{subtext}}
border-color=#{{overlay}}
default-timeout=3000

# Critical: red border, stays until dismissed.
[urgency=critical]
border-color=#{{red}}
default-timeout=0

# Do-not-disturb hides everything except critical notifications.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
