/* Generated by hypr-theme from themes/{{name}}.colors — do not edit.
 * Edit the palette or themes/templates/rofi.rasi, then: hypr-theme apply */
* {
    base:      #{{base}};
    backdrop:  #{{base}}26;   /* base at 15%: the frosted tint behind the panel */
    surface:   #{{surface}};
    surface2:  #{{surface2}};
    overlay:   #{{overlay}};
    frame:     #{{frame}};
    muted:     #{{muted}};
    subtext:   #{{subtext}};
    text:      #{{text}};
    accent:    #{{accent}};
    accent-fg: #{{accent_fg}};
}
