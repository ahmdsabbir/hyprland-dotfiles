// Waybar: minimal pill bar. Event-driven modules only, no polling scripts.
// Docs: https://github.com/Alexays/Waybar/wiki
{
    "layer": "top",
    "position": "top",
    "height": 26,
    // Match Hyprland's gaps_out (6) so the bar lines up with windows.
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 6,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": ["pulseaudio", "network", "battery", "clock", "custom/power"],

    // Workspaces as plain pills (no labels); the active one is wider and darker.
    "hyprland/workspaces": {
        "format": "",
        "persistent-workspaces": { "*": 5 },
        // Hyprland's Lua config uses hl.dsp.* dispatchers.
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },

    "network": {
        "interval": 30,
        "format-wifi": "{signalStrength}% 󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} · {ipaddr}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    // Hidden automatically on machines without a battery.
    "battery": {
        "interval": 60,
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰚥",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󱟢"],
        "states": { "warning": 25, "critical": 10 }
    },

    "clock": {
        "interval": 60,
        "format": "{:%d/%m %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": { "mode": "month", "weeks-pos": "" }
    },

    // Power: click for a dropdown menu (power-menu.xml).
    // Each action asks for confirmation (bin/.local/bin/hypr-power).
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power-menu.xml",
        "menu-actions": {
            "logout": "$HOME/.local/bin/hypr-power logout",
            "reboot": "$HOME/.local/bin/hypr-power reboot",
            "shutdown": "$HOME/.local/bin/hypr-power shutdown"
        }
    }
}
